{
  "name": "memclawrizer",
  "productName": "memclawrizer",
  "version": "0.0.3",
  "description": "Time-pressured drill trainer: an arcade claw, a Leitner scheduler, and a jar you only get to keep if you're perfect",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:mock": "cross-env VITE_FORCE_MOCK=1 electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test test/e2e",
    "gen:decks": "tsx scripts/gen-kana.ts && tsx scripts/gen-piano.ts"
  },
  "keywords": [],
  "author": {
    "name": "Elena Felder",
    "email": "41136058+elefeint@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.61.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "electron": "42.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "^0.8.3"
  }
}
